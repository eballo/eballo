# ~/.config/taskjournal/.env
# This is a sample .env file for taskjournal

# Taskjournal configuration
TEMPLATE_FORMAT="md" #either "md" or "txt"
BASE_DIR="/Users/your-user/work/DailyNotes/"
BASE_PROJECT="/Users/your-user/work/taskjournal/taskjournal/"
BACKUP_DIR="/Users/your-user/work/DailyNotes/backups/"

# JIRA configuration
JIRA_ORGANIZATION="my-organization"
JIRA_API_TOKEN="jira-key"
JIRA_EMAIL="jira-email"
JIRA_BOARD_ID="jira-board-id"

# GitHub configuration
GIT_HUB_ORGANIZATION_NAME="my-github-org"
GIT_HUB_TOKEN="gh-key"

# OpenAI configuration (used for AI-generated weekly/monthly summaries)
OPENAI_API_KEY="sk-..."

# WiFi-based work location detection
HOME_WIFI="my-home-wifi"
OFFICE_WIFI="my-office-wifi"
